          "request": {
            "name": "Login",
            "description": {
              "content": "Exchange Looker API client_id and client_secret for an OAuth-style access token used to authorize subsequent API requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Looker API client ID for the user account being authenticated."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "(Required) Looker API client secret paired with the client_id."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "16fe504b-3f36-41c7-96f9-cd51023df32c",
              "name": "Successful login response containing the access token.",
              "originalRequest": {
                "url": {
                  "path": [
                    "login"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "client_id",
